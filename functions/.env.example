# Non-secret function parameters. Copy to functions/.env.<project-id> (gitignored) before deploying.
PADDLE_ENV=sandbox
# JSON map of Paddle price id -> plan id. Plans: starter, growth, pro_growth, pro_scale, pro_pro, custom
PADDLE_PRICE_MAP={"pri_REPLACE":"starter"}
BILLING_GRACE_DAYS=7
APP_URL=https://app.7captur.com
