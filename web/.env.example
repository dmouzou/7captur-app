# Copy to .env.local (dev) and set per-environment values in CI for prod.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Set to "true" to talk to local emulators
VITE_USE_EMULATORS=false

# Paddle (client-side token and public price ids only; never put API keys here)
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
# JSON map of plan id to Paddle price id, e.g. {"starter":"pri_...","growth":"pri_...","pro_growth":"pri_...","pro_scale":"pri_...","pro_pro":"pri_..."}
VITE_PADDLE_PRICES={}
