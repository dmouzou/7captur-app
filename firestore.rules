rules_version = '2';

// Deny by default. Tenant model: users -> workspaces -> businesses -> records.
// Clients can NEVER write: plan/entitlements, usage, billing, connections, tokens,
// recommendations, recommendation events, audit events, config. Those go through Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function memberDoc(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
    }
    function isMember(wid) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid))
        && memberDoc(wid).data.status == 'active';
    }
    function notSuspended(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)).data.get('suspended', false) != true;
    }
    function notReadOnly(wid) {
      let w = get(/databases/$(database)/documents/workspaces/$(wid)).data;
      let b = w.get('billingStatus', '');
      // overLimit: this workspace is beyond what the account's plan allows (for example after a downgrade). Read-only, never deleted.
      return b != 'trial_expired' && b != 'restricted' && w.get('overLimit', false) != true;
    }
    function canEdit(wid) {
      return isMember(wid) && memberDoc(wid).data.role in ['owner', 'editor'] && notSuspended(wid) && notReadOnly(wid);
    }

    // Manual input records (posts, promotions, leads, sales, costs).
    function validNewRecord(wid) {
      let d = request.resource.data;
      return d.workspaceId == wid
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time
        && d.provenance == 'manual'
        && d.businessId is string;
    }
    // Connected (synced) records: clients may only edit link fields, never the synced numbers.
    function connectedEditOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['postId', 'promotionId', 'leadId', 'attribution', 'notes', 'updatedAt']);
    }
    function validRecordUpdate(wid) {
      let d = request.resource.data;
      return (resource.data.provenance != 'connected' || connectedEditOnly())
        && d.workspaceId == resource.data.workspaceId
        && d.workspaceId == wid
        && d.businessId == resource.data.businessId
        && d.createdBy == resource.data.createdBy
        && d.provenance == resource.data.provenance
        && d.updatedAt == request.time;
    }

    // Server-written only. config/ai holds the model API key, so nothing here is public except the FX rates.
    match /config/fx {
      allow read: if signedIn();
      allow write: if false;
    }
    match /config/{doc} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role', 'defaultWorkspaceId']);
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'defaultWorkspaceId']);
      allow delete: if false;

      match /prefs/{docId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid
          && (request.resource == null || !request.resource.data.keys().hasAny(['role', 'defaultWorkspaceId']));
      }
    }

    // The account (accounts/{ownerUid}) owns the plan, subscription and the shared usage counters.
    // Plan fields are mirrored onto each workspace doc by the server. Clients never write here.
    match /accounts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
      match /usage/{periodId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      // billing/subscription and everything else under the account is server-only.
    }

    match /workspaces/{wid} {
      // Workspace doc holds plan reference, so it is read-only for clients.
      allow get: if isMember(wid) || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // An owner lists their own workspaces with where("ownerUid", "==", uid): provable from the query itself.
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(wid);
        allow write: if false;
      }

      match /businesses/{bid} {
        allow read: if isMember(wid);
        allow create: if false;  // plan business-count limit is enforced by createWorkspace / later callable
        allow update: if canEdit(wid)
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'type', 'objective', 'channels', 'buyingMethods', 'currency', 'timezone', 'products', 'updatedAt']);
        allow delete: if false;
      }

      match /{coll}/{recordId} {
        allow read: if coll in ['posts', 'promotions', 'leads', 'sales', 'costs'] && isMember(wid);
        allow create: if coll in ['posts', 'promotions', 'leads', 'sales', 'costs']
          && canEdit(wid) && validNewRecord(wid);
        allow update: if coll in ['posts', 'promotions', 'leads', 'sales', 'costs']
          && canEdit(wid) && validRecordUpdate(wid);
        allow delete: if coll in ['posts', 'promotions', 'leads', 'sales', 'costs'] && canEdit(wid)
          && resource.data.provenance != 'connected';
      }

      // Server-written, member-readable.
      match /recommendations/{id} {
        allow read: if isMember(wid);
        allow write: if false;
      }
      match /recommendationEvents/{id} {
        allow read: if isMember(wid);
        allow write: if false;
      }
      // v2 decision layer: server-written, member-readable, same as recommendations.
      match /decisions/{id} {
        allow read: if isMember(wid);
        allow write: if false;
        // AI follow-up questions and answers, server-written.
        match /followups/{fid} {
          allow read: if isMember(wid);
          allow write: if false;
        }
      }
      match /decisionEvents/{id} {
        allow read: if isMember(wid);
        allow write: if false;
      }
      match /reports/{id} {
        allow read: if isMember(wid);
        allow write: if false;
      }
      match /usage/{periodId} {
        allow read: if isMember(wid);
        allow write: if false;
      }
      match /imports/{jobId} {
        allow read: if isMember(wid);
        allow write: if false;
      }

      // In-app notifications are written by Functions. Members may only mark them read.
      match /notifications/{id} {
        allow read: if isMember(wid);
        allow update: if isMember(wid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow create, delete: if false;
      }

      // Connection docs hold status only. Tokens live in Secret Manager, never in Firestore.
      match /connections/{id} {
        allow read: if isMember(wid);
        allow write: if false;
      }

      // Billing state comes only from verified provider webhooks.
      match /billing/{id} {
        allow read: if isMember(wid) && memberDoc(wid).data.role == 'owner';
        allow write: if false;
      }

      // Feedback & support tickets are written via Functions callable submitFeedback.
      match /feedback/{id} {
        allow read: if isMember(wid);
        allow write: if false;
      }

      // Recent source usage tracking for cards: member-readable, client-writable only for own recents
      match /recentSources/{cardId} {
        allow read: if isMember(wid);
        allow write: if isMember(wid)
          && request.resource.data.keys().hasOnly(['lastUsedAt', 'updatedAt'])
          && notSuspended(wid)
          && notReadOnly(wid);
      }
    }

    match /auditEvents/{id} {
      allow read, write: if false;
    }

    // Admin-only data. Never readable or writable by clients (the default deny already covers it; stated here so it stays so).
    // planOverrides holds the reason and the admin behind a manual plan change.
    // supportTickets holds internal notes.
    match /planOverrides/{id} {
      allow read, write: if false;
    }
    match /supportTickets/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
